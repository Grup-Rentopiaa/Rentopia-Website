generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Auth {
  id Int @id @default(autoincrement())
  user_id Int @unique
  user Users @relation(fields: [user_id], references: [id])
  password String
  otp String?
  otp_expired_at DateTime?
}
model Users {
    id Int @id @default(autoincrement())
    auth Auth?
    username String
    email String @unique
}
model Visitor {
  id            Int      @id @default(autoincrement())
  visitor_id    String
  page          String
  path          String?
  browser       String?
  language      String?
  screen_width  Int?
  screen_height Int?
  visited_at    String?
  created_at    DateTime @default(now())
}