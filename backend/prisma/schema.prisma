generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id          Int    @id @default(autoincrement())
  username    String    @unique
  name        String?
  city        String?
  description String?
  phone       String?  @db.VarChar(20)   
  avatarB64   String?  @map("avatar_b64") 
  followers   Int    @default(0)
  following   Int    @default(0)
  rating      Float    @default(0)      
  totalSewa   Int      @default(0)        @map("total_sewa") 
  createdAt   DateTime    @default(now()) @map("created_at")

  listings  Listing[]
  rentals   Rental[]

  @@map("users")
}

model Listing {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  title     String        @db.VarChar(255)
  price     String        @db.VarChar(64)
  brand     String        @db.VarChar(64)
  category  String        @db.VarChar(64) @default("Lainnya")
  image     String?
  status    ListingStatus @default(available)
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("listings")
}

model Rental {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  title     String       @db.VarChar(255)
  price     String       @db.VarChar(64)
  store     String       @db.VarChar(128)
  status    RentalStatus @default(ongoing)
  note      String?      @db.VarChar(128)
  image     String?                        
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rentals")
}

enum ListingStatus { 
  available  
  rented 
}
enum RentalStatus  { 
  ongoing  
  done  
  urgent 
}