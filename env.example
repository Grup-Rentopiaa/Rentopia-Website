# ============================================================
# Rentopia — Environment Variables
# Cara pakai: copy file ini ke .env lalu isi nilainya
#   cp .env.example .env
# JANGAN commit file .env ke git!
# ============================================================

# ── Database ──────────────────────────────────────────────
DB_USER=rentopia_user
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=rentopia_db

# ── Backend ───────────────────────────────────────────────
# Wajib diganti — minimal 32 karakter random
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_32_karakter

# Wajib diganti — harus 32 karakter PERSIS untuk AES-256
ENCRYPTION_KEY=ganti_32karakter_persis_disini!!

# Port backend (default 3000)
PORT=3000

NODE_ENV=development

# ── Email (Gmail SMTP) ────────────────────────────────────
# Pakai App Password Google, bukan password akun biasa
# Cara buat App Password: myaccount.google.com → Security → App passwords
EMAIL_USER=email_kamu@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ── CORS ──────────────────────────────────────────────────
# URL frontend yang boleh akses backend
# Dev: http://localhost:5173
# Production: https://namadomain.com
CLIENT_ORIGIN=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────
# URL backend yang diakses dari BROWSER (bukan dari container)
# Dev: http://localhost:3000
# Production: https://api.namadomain.com
VITE_API_URL=http://localhost:3000/api/auth
VITE_TRACKING_URL=http://localhost:3000/api/tracking/track-visitor
VITE_WS_URL=ws://localhost:3000
